# Copy to .env (git-ignored) and fill in your glitch.fun credentials.
# Option A: email (or username) + password — the script logs in and fetches the auth token itself.
GLITCH_EMAIL=
GLITCH_PASSWORD=
#GLITCH_USERNAME=

# Option B: paste a ready JWT (browser DevTools -> any api.glitch.fun request -> Authorization header).
#GLITCH_AUTH_TOKEN=

# Defaults to the Blocks Beyond The Stars title id when unset.
#GLITCH_TITLE_ID=80f5dc18-dc0f-45de-9a57-8599e08669ed
