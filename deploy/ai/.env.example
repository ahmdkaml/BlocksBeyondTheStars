# Operator configuration for the AI backend — copy to /opt/bbs/ai/.env on the VPS and fill in real
# values. The real .env is NEVER in git and NEVER touched by deploy.yml (it only rewrites the AI_TAG
# line when a deploy pins a new image tag). The API key lives ONLY here.

# Image tag to run — deploy.yml pins this to an immutable sha-<short> tag; rollback = previous tag.
AI_TAG=latest

# Any OpenAI-compatible endpoint. Official fleet: OVHcloud AI Endpoints (serverless, pay per token).
BBTS_AI_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
BBTS_AI_API_KEY=
# Decided 2026-07-05: Mistral Small — non-reasoning, ~0.5 s per NPC line, $0.10/M in + $0.31/M out.
# (Qwen3.5-9B on the same endpoint is a reasoning model with no think-off switch: slow + empty lines.)
BBTS_AI_MODEL=Mistral-Small-3.2-24B-Instruct-2506
BBTS_AI_TEMPERATURE=0.8
# Generous by design — the game never blocks on this (instant static line, async LLM upgrade). Keep it
# BELOW the game server's BBS_AI_TIMEOUT_SECONDS (default 35) so template fallbacks always arrive.
BBTS_AI_TIMEOUT=30
